/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 20rpx;
}

.button {
  margin: 20rpx 0;
  padding: 20rpx;
  background-color: #1890ff;
  color: white;
  border-radius: 8rpx;
  text-align: center;
  font-size: 32rpx;
}

.input {
  margin: 10rpx 0;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.select {
  margin: 10rpx 0;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 32rpx;
}

.textarea {
  margin: 10rpx 0;
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 32rpx;
  min-height: 150rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 20rpx 0;
}

.subtitle {
  font-size: 32rpx;
  margin: 10rpx 0;
}

.result {
  margin: 20rpx 0;
  padding: 20rpx;
  background-color: #e6f7ff;
  border-radius: 8rpx;
}

.result-item {
  margin: 10rpx 0;
  font-size: 32rpx;
}