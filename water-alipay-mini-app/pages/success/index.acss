.container {
  padding: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin: 40rpx 0;
  text-align: center;
  color: #52c41a;
}

.result {
  margin: 40rpx 0;
  padding: 30rpx;
  background-color: #f6ffed;
  border: 1rpx solid #b7eb8f;
  border-radius: 12rpx;
}

.result-item {
  margin: 20rpx 0;
  display: flex;
  align-items: center;
}

.label {
  font-size: 32rpx;
  color: #333;
  width: 200rpx;
}

.value {
  font-size: 32rpx;
  color: #666;
  flex: 1;
}

.button {
  margin: 60rpx 0;
  padding: 24rpx;
  background-color: #1890ff;
  color: white;
  border-radius: 12rpx;
  text-align: center;
  font-size: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.button:active {
  background-color: #40a9ff;
}