.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 20rpx;
  background-color: #f5f5f5;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
  color: #1890ff;
}

.form {
  width: 100%;
  max-width: 600rpx;
  background-color: white;
  padding: 40rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background-color: #fafafa;
}

.input:focus {
  border-color: #1890ff;
  background-color: white;
}

.login-button {
  width: 100%;
  height: 80rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
  border-radius: 8rpx;
}

.tip {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}