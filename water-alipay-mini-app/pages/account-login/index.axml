<view class="container">
  <view class="title">账号密码登录</view>
  
  <view class="form">
    <view class="form-item">
      <view class="label">用户名</view>
      <input 
        class="input" 
        placeholder="请输入用户名" 
        value="{{username}}" 
        onInput="onUsernameInput"
      />
    </view>
    
    <view class="form-item">
      <view class="label">密码</view>
      <input 
        class="input" 
        placeholder="请输入密码" 
        value="{{password}}" 
        onInput="onPasswordInput"
        password
      />
    </view>
    
    <button 
      class="login-button" 
      type="primary" 
      onTap="login"
      disabled="{{loading}}"
    >
      {{loading ? '登录中...' : '登录'}}
    </button>
  </view>
  
  <view class="tip">测试账号: admin, 密码: 123456</view>
</view>