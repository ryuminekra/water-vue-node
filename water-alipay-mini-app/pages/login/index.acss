.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  padding: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 40rpx;
  color: #1890ff;
}

.subtitle {
  font-size: 32rpx;
  margin-bottom: 60rpx;
  color: #666;
}

.button {
  width: 80%;
  padding: 24rpx;
  background-color: #1890ff;
  color: white;
  border-radius: 12rpx;
  text-align: center;
  font-size: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.button:active {
  background-color: #40a9ff;
}