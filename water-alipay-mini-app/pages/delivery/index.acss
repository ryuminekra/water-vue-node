.container {
  padding: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin: 20rpx 0;
  text-align: center;
  color: #1890ff;
}

.form-item {
  margin: 20rpx 0;
}

.label {
  display: block;
  font-size: 32rpx;
  margin-bottom: 10rpx;
  color: #333;
}

.input {
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 32rpx;
  background-color: #ffffff;
}

.textarea {
  padding: 20rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  font-size: 32rpx;
  min-height: 150rpx;
  background-color: #ffffff;
}

.value {
  font-size: 32rpx;
  color: #666;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.button {
  margin: 40rpx 0;
  padding: 24rpx;
  background-color: #1890ff;
  color: white;
  border-radius: 12rpx;
  text-align: center;
  font-size: 36rpx;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.3);
}

.button:active {
  background-color: #40a9ff;
}