/* app.wxss */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 20rpx;
}

.btn-primary {
  background-color: #1890ff;
  color: white;
  border-radius: 8rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 32rpx;
  margin-top: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-select {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  min-height: 150rpx;
}

.success-icon {
  width: 150rpx;
  height: 150rpx;
  margin: 50rpx auto;
  display: block;
}

.success-text {
  text-align: center;
  font-size: 36rpx;
  color: #52c41a;
  margin-bottom: 30rpx;
}

.success-detail {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 50rpx;
}

.back-btn {
  margin-top: 30rpx;
}